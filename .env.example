# Copy to .env and fill in for local dev
# In production, set these via your deployment platform's secret manager.

# JWT signing key. Rotating invalidates all issued tokens.
ARKAFON_SECRET_KEY=change-me-to-a-long-random-string
ARKAFON_TOKEN_EXPIRE_MINUTES=10080

# SQLAlchemy URL. SQLite for local; Postgres for prod.
# e.g. postgresql+psycopg2://user:pass@host:5432/arkafon
ARKAFON_DATABASE_URL=sqlite:///./arkafon.db

# CORS: comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# TCMB EVDS API key (optional, for official USD/TRY rates).
TCMB_API_KEY=
